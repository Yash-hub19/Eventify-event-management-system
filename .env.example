PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eventify
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5500

# Nodemailer (optional - if not set, emails are just logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Eventify <no-reply@eventify.com>"
